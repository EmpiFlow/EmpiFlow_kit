# ─────────────────────────────────────────────────────────────────────────────
# EmpiFlow kit — the settings you own.
#
# `Install.cmd` writes `.env` and asks for the first five values.
# You may also edit `.env` by hand, then run `scripts\restart.cmd`.
# `.env` is never committed and never sent anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# The name ERPNext knows your site by. Letters, digits, dots and dashes.
# Changing it later does NOT rename an existing site, it creates a second one.
SITE_NAME=empiflow.local

# Password for the ERPNext user `Administrator`.
ADMIN_PASSWORD=admin

# Password for the stack's own database. It is never exposed to the network.
DB_PASSWORD=admin

# Password of the read-only database user Metabase uses (D-006).
# You will type this into Metabase once, on its first run.
MB_RO_PASSWORD=metabase_ro

# Browser ports, bound to 127.0.0.1 only — nothing on your network can reach them (D-005).
HTTP_PORT=8080
METABASE_PORT=3000

# Where the WSL Linux disk (2–4 GB) is created. The default is on C:. If C: is small, uncomment
# the next line before the FIRST install and point it at a folder on another drive. Moving it
# afterwards does not move an existing distribution; it only affects a new import (D-017).
# WSL_ROOT=D:\EmpiFlow\wsl


# ── advanced: normally leave these alone ─────────────────────────────────────
# The image is built by CI and published in ghcr; the tag is promoted only after
# the acceptance suite has passed against it (D-011).
EMPI_IMAGE=ghcr.io/empiflow/empiflow-kit-erpnext
EMPI_IMAGE_TAG=v1.0.0
